# Address of the API (with /api/v1 at the end). Copy this file to .env.
#
# Phone with Expo Go (same Wi-Fi as the laptop): use the laptop's Wi-Fi IP.
#   Windows: run `ipconfig` and look for "IPv4 Address"
#   macOS:   run `ipconfig getifaddr en0`
# Android emulator: http://10.0.2.2:3000/api/v1
# iOS simulator or web browser: http://localhost:3000/api/v1
#
# Restart `npx expo start` after changing this file.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1
