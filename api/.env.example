PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=wedding_venues

# at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# browser origins allowed to call the API (comma-separated). Leave empty for
# mobile-only use; add http://localhost:8081 to test the app in a web browser.
CORS_ORIGINS=
